<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netcoreapp3.1;netstandard2.1</TargetFrameworks>
    <RootNamespace>WriteAs.NET</RootNamespace>
    <AssemblyName>WriteAs.NET</AssemblyName>
    <Authors>Dino Bansigan</Authors>
    <Description>An unofficial .NET client for the Write.as API written in C#.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>WriteAs.NET</PackageId>
    <Product>WriteAs.NET</Product>
    <RepositoryUrl>https://github.com/DinoBansigan/WriteAs.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DinoBansigan/WriteAs.NET</PackageProjectUrl>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <PackageReleaseNotes>Added user-agent header value to allow calls to the Write.as api to go through.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="5.0.0" />
  </ItemGroup>

</Project>
